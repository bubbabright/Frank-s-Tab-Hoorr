{
  "manifest_version": 2,
  "name": "Tab Hoor",
  "version": "0.2.0",
  "description": "Gamifies your tab hoarding. Ranks, achievements, history — all local.",
  "author": "frank",

  "permissions": ["tabs", "storage"],

  "background": {
    "scripts": ["data.js", "background.js"],
    "persistent": true
  },

  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_title": "Tab Hoor",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg",
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },

  "content_security_policy": "script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; object-src 'self'",

  "browser_specific_settings": {
    "gecko": {
      "id": "tabhoor@franklife",
      "strict_min_version": "60.0"
    }
  }
}
