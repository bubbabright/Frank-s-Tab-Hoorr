{
  "manifest_version": 2,
  "name": "Tab Hoor",
  "version": "0.1.0",
  "description": "Find out exactly what kind of hoor you are. Track your tabs, earn your rank, own it.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_popup": "popup/popup.html",
    "default_title": "Tab Hoor"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "permissions": [
    "tabs",
    "storage",
    "windows"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-hoor@frank",
      "strict_min_version": "57.0"
    }
  }
}
